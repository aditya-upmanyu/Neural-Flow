# ===================================
# BharatBazaar — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ===================================

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# PORT and INSTANCE_ID are set per-instance by startInstances.js.
# You only need to set these manually if running a single instance.
PORT=5001
INSTANCE_ID=BB-NODE-1
REGION=Mumbai

# ── Multi-node ports (used by scripts/startInstances.js) ─────────────────────
NODE_1_PORT=5001
NODE_2_PORT=5002
NODE_3_PORT=5003

# ── Database ─────────────────────────────────────────────────────────────────
# Local MongoDB (default):
MONGO_URI=mongodb://localhost:27017/live-shopping

# MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/live-shopping

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random string — e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# ── Payment Gateway (Razorpay) ────────────────────────────────────────────────
# Use TEST keys during development. Never use live keys in .env.example.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ── NFV5 Integration ──────────────────────────────────────────────────────────
# URL of NFV5 backend for sending payment events
NFV5_BACKEND_URL=http://localhost:3001

# ── WhatsApp Business ─────────────────────────────────────────────────────────
WHATSAPP_BUSINESS_NUMBER=91XXXXXXXXXX

# ── CORS ─────────────────────────────────────────────────────────────────────
SOCKET_CORS_ORIGIN=*
FRONTEND_URL=http://localhost:5001

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Admin seed account ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@bharatbazaar.local
ADMIN_PASSWORD=change-this-before-use

# ── Cloud storage (optional) ─────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
SESSION_SECRET=replace-with-a-random-session-secret
NGROK_URL=
