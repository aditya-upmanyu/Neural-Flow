# ═══════════════════════════════════════════════════════════════════════════
# BharatBazaar Backend - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values

# ── SERVER ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# ── MONGODB ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/live-shopping
MONGODB_DB_NAME=live-shopping

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRY=24h

# ── RAZORPAY ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
RAZORPAY_API_URL=https://api.razorpay.com

# ── NFVV5 INTEGRATION ─────────────────────────────────────────────────────
NEURALFLOW_API_URL=http://localhost:3001
NEURALFLOW_WEBHOOK_URL=http://localhost:3001/api/razorpay/event
NEURALFLOW_API_KEY=optional_key_for_authentication

# ── EMAIL (OPTIONAL) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@bharatbazaar.com

# ── AWS S3 (OPTIONAL - For product images) ────────────────────────────────
AWS_ACCESS_KEY_ID=optional
AWS_SECRET_ACCESS_KEY=optional
AWS_REGION=ap-south-1
AWS_S3_BUCKET=bharatbazaar-images

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:5001

# ── LOGGING ───────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── FEATURES ──────────────────────────────────────────────────────────────
ENABLE_RAZORPAY=true
ENABLE_PAYMENT_WEBHOOK=true
