# NeuralFlow V4 - Environment Configuration Example
# Copy this to SENSITIVE_FILES/.env and fill in real values (NOT committed to git)

# Backend Server
BACKEND_PORT=3000
BACKEND_HOST=localhost
NODE_ENV=development

# Frontend Configuration
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# BharatBazaar Configuration (external simulation)
BHARATBAZAAR_PORT_1=5001
BHARATBAZAAR_PORT_2=5002
BHARATBAZAAR_PORT_3=5003
BHARATBAZAAR_HOST=localhost

# Internal Node Simulation
INTERNAL_NODE_PORT_1=4001
INTERNAL_NODE_PORT_2=4002
INTERNAL_NODE_PORT_3=4003

# ML Configuration
ML_TRAINING_SAMPLES=500
ML_TRAINING_ITERATIONS=2000
ML_SEED=42

# Safety Gate Policy (configurable thresholds)
SAFETY_MIN_CONFIDENCE=0.80
SAFETY_MAX_TARGET_CPU=80
SAFETY_MIN_TARGET_HEALTH=65
SAFETY_MAX_TELEMETRY_AGE_MS=5000
SAFETY_COOLDOWN_MS=15000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Demo Mode
DEMO_MODE_ENABLED=false

# WebSocket
WS_PORT=3000
WS_PATH=/ws

# IMPORTANT NOTES:
# 1. DO NOT commit the actual .env file - only this .env.example template
# 2. Copy this file to SENSITIVE_FILES/.env and fill in your local values
# 3. The .gitignore is configured to never commit SENSITIVE_FILES/.env
# 4. For production deployment, use environment variables directly (not .env files)
