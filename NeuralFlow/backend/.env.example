# ═══════════════════════════════════════════════════════════════════════════
# NeuralFlow V5 Backend - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values

# ── SERVER CONFIGURATION ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ── ROUTER PORTS ──────────────────────────────────────────────────────────
INTERNAL_ROUTER_PORT=4000
EXTERNAL_ROUTER_PORT=5100

# ── DEMO NODES CONFIGURATION ──────────────────────────────────────────────
DEMO_NODES_PORT_START=4001
DEMO_NODE_1_PORT=4001
DEMO_NODE_2_PORT=4002
DEMO_NODE_3_PORT=4003

# ── LOGGING ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
INCIDENT_LOG_DIR=../logs
RECEIPTS_FILE=../logs/incident_receipts.json

# ── AI MODEL CONFIGURATION ────────────────────────────────────────────────
ML_MODEL_STATUS=trained
ML_ACCURACY_THRESHOLD=0.85
ML_CONFIDENCE_MIN=0.75

# ── SAFETY GATES ──────────────────────────────────────────────────────────
ENABLE_SAFETY_GATES=true
SAFETY_GATE_CHECKS=8

# ── VERIFICATION ──────────────────────────────────────────────────────────
VERIFICATION_ENABLED=true
VERIFICATION_POLLS=3

# ── KILL SWITCH ───────────────────────────────────────────────────────────
ENABLE_KILL_SWITCH=true
MAX_ROLLBACKS=3

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── DEVELOPMENT ───────────────────────────────────────────────────────────
DEBUG=false

# ====================================
# SECURITY CONFIGURATION
# ====================================
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
