# ===========================================
# NeuralFlow V4 Frontend Configuration  
# ===========================================

# API Configuration
VITE_BACKEND_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# Feature Flags
VITE_ENABLE_3D_VIEW=true
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_MANUAL_CONTROLS=true
VITE_ENABLE_AI_EXPLAINER=true
VITE_ENABLE_ATTACK_SIMULATION=true

# 3D Visualization Settings
VITE_3D_RENDER_QUALITY=high
VITE_3D_ENABLE_SHADOWS=true
VITE_3D_ENABLE_BLOOM=true
VITE_3D_ENABLE_PARTICLES=true
VITE_3D_MAX_PARTICLES=500

# UI Configuration
VITE_THEME=dark
VITE_ENABLE_ANIMATIONS=true
VITE_REFRESH_INTERVAL=1000
VITE_CHART_UPDATE_INTERVAL=2000

# Performance Settings
VITE_WS_RECONNECT_ATTEMPTS=5
VITE_WS_RECONNECT_DELAY=3000
VITE_API_TIMEOUT=10000

# Debug/Development (set to false in production)
VITE_ENABLE_DEBUG_CONSOLE=false
VITE_SHOW_PERFORMANCE_STATS=false
VITE_ENABLE_ERROR_BOUNDARY=true

# Monitoring Dashboard
VITE_DEFAULT_TIME_RANGE=1h
VITE_MAX_EVENT_LOG_ENTRIES=1000
VITE_AUTO_REFRESH_ENABLED=true

# Export/Report Features
VITE_ENABLE_PDF_EXPORT=true
VITE_ENABLE_CSV_EXPORT=true
VITE_MAX_EXPORT_ENTRIES=10000

# Demo Mode Settings
VITE_DEMO_AUTO_START=false
VITE_DEMO_LOOP_ENABLED=false
VITE_DEMO_STEP_DURATION=5000

# Real Website Integration (if using external monitoring)
VITE_ENABLE_REAL_WEBSITE_MONITORING=false
VITE_MONITORED_WEBSITE_URL=https://example.com
VITE_WEBSITE_CHECK_INTERVAL=30000