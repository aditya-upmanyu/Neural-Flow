{
  "name": "neuralflow-v5",
  "version": "5.0.0",
  "description": "AI-Powered Autonomous Infrastructure Resilience Platform - NFV5",
  "scripts": {
    "install-all": "npm install --prefix backend && npm install --prefix \"BharatBazaar 2/BharatBazaar/BharatBazaar\"",
    "start:backend": "node backend/src/server.js",
    "start:bharatbazaar": "npm run start:single --prefix \"BharatBazaar 2/BharatBazaar/BharatBazaar\"",
    "start:all": "concurrently -n \"NFV5,BharatBazaar\" -c \"cyan,magenta\" \"npm run start:backend\" \"npm run start:bharatbazaar\"",
    "start": "npm run start:all",
    "build-frontend": "npm run build --prefix frontend",
    "build": "npm run render-build",
    "test": "npm test --prefix backend",
    "render-build": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend",
    "render-start": "node backend/src/server.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
