# ═══════════════════════════════════════════════════════════════════════════
# NFV5 - NeuralFlow V5 Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values

# ── NODE ENVIRONMENT ──────────────────────────────────────────────────────
NODE_ENV=development
# development, production

# ── PORT CONFIGURATION ────────────────────────────────────────────────────
NEURALFLOW_PORT=3001
INTERNAL_ROUTER_PORT=4000
EXTERNAL_ROUTER_PORT=5100
BHARATBAZAAR_PORT=5001

# ── DATABASE (MONGODB) ────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/neuralflow-v5
MONGODB_DB_NAME=neuralflow-v5

# ── RAZORPAY INTEGRATION (OPTIONAL - For BharatBazaar) ────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# ── AI/ML CONFIGURATION ───────────────────────────────────────────────────
ML_MODEL_PATH=./models/neural-network.model
ML_CONFIDENCE_THRESHOLD=0.75
ML_RISK_THRESHOLD=60
ML_TRAINING_SAMPLES=500

# ── SAFETY GATES CONFIGURATION ────────────────────────────────────────────
SAFETY_GATE_MIN_CONFIDENCE=0.80
SAFETY_GATE_MAX_TARGET_CPU=80
SAFETY_GATE_MIN_TARGET_HEALTH=65
SAFETY_GATE_MAX_TELEMETRY_AGE_MS=5000
SAFETY_GATE_COOLDOWN_MS=15000
SAFETY_GATE_MIN_HEALTHY_ALTERNATIVES=1

# ── VERIFICATION ENGINE ──────────────────────────────────────────────────
VERIFICATION_POLL_COUNT=3
VERIFICATION_POLL_INTERVAL_MS=2000
VERIFICATION_LATENCY_THRESHOLD=100
VERIFICATION_ERROR_RATE_THRESHOLD=2.0

# ── INCIDENT TRACKING ────────────────────────────────────────────────────
INCIDENT_LOG_DIR=./logs
INCIDENT_RECEIPTS_FILE=./logs/incident_receipts.json
INCIDENT_EXPORTS_DIR=./logs/exports
MAX_STORED_RECEIPTS=200

# ── ROLLBACK CONFIGURATION ───────────────────────────────────────────────
MAX_ROLLBACKS_PER_INCIDENT=3
ROLLBACK_TIMEOUT_MS=10000

# ── LOGGING ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
# debug, info, warn, error
LOG_FORMAT=json
# json, text

# ── FEATURE FLAGS ────────────────────────────────────────────────────────
ENABLE_AI_AUTONOMY=true
ENABLE_KILL_SWITCH=true
ENABLE_DECISION_RECEIPTS=true
ENABLE_WEBHOOK_VERIFICATION=true

# ── DEPLOYMENT ───────────────────────────────────────────────────────────
# For Render.com deployment
RENDER_INTERNAL_IP=0.0.0.0

# For development
DEBUG=true
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5001

# ====================================
# LLM POSTMORTEM GENERATOR (Optional)
# ====================================
# Phase 2 Feature: Auto-generate plain-English postmortems
# Get your API key from: https://console.anthropic.com/
# GEMINI_API_KEY=your-gemini-api-key-here