async function pushWebhookEvent(event) {
  const url = runtimeSettings.webhookUrl;
  if (!url || typeof url !== 'string') return;
  
  // Security: only allow HTTP/HTTPS webhooks
  if (!url.startsWith('http://') && !url.startsWith('https://')) {
    console.warn(`[SECURITY] Blocked non-HTTP webhook URL: ${url}`);
    return;
  }
  
  const body = JSON.stringify({
    source: 'NeuralFlow V5',
    environment: activeEnvironment,
    event: {
      type:      event.type,
      severity:  event.severity,
      nodeId:    event.nodeId,
      message:   event.message,
      timestamp: event.timestamp,
    },
  });
  http.request(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) },
    timeout: 4000,
  }, (res) => { res.resume(); })
    .on('error', () => {})
    .end(body);
}

