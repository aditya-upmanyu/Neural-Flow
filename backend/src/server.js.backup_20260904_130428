// Rollback specific action
app.post('/api/actions/:actionId/rollback', validateBody(rollbackSchema), (req, res) => {
  const { actionId } = req.params;
  const { reason, operator } = req.body;
  
  if (!lastActionSnapshot) {
    return res.status(404).json({
      success: false,
      error: 'No action snapshot available to rollback'
    });
  }
  
  // Check rollback limit
  const incidentRollbacks = rollbackHistory.filter(r => 
    r.incidentId === lastActionSnapshot.incidentId
  ).length;
  
  if (incidentRollbacks >= MAX_ROLLBACKS_PER_INCIDENT) {
    return res.status(400).json({
      success: false,
      error: `Maximum rollbacks (${MAX_ROLLBACKS_PER_INCIDENT}) exceeded for this incident. Human intervention required.`
    });
  }
  
  console.log(`⏪ ROLLBACK initiated by ${operator}: ${reason}`);
  
  // Restore previous traffic weights
  const beforeWeights = [];
  const afterWeights = [];
  
  activeNodes.forEach(node => {
    beforeWeights.push({ nodeId: node.nodeId, weight: node.metrics.traffic });
    
    const snapshot = lastActionSnapshot.nodeStates.find(s => s.nodeId === node.nodeId);
    if (snapshot) {
      node.metrics.traffic = snapshot.trafficWeight;
      afterWeights.push({ nodeId: node.nodeId, weight: snapshot.trafficWeight });
    }
  });
  
  // Record rollback
  const rollback = {
    rollbackId: `RB-${Date.now()}`,
    actionId,
    incidentId: lastActionSnapshot.incidentId,
    operator,
    reason,
    timestamp: Date.now(),
    beforeWeights,
    afterWeights,
    restoredState: lastActionSnapshot
  };
  
  rollbackHistory.push(rollback);
  
  // Create rollback receipt
  createReceipt({
    incidentId: `ROLLBACK-${actionId}`,
    scenario: 'ROLLBACK',
    environment: activeEnvironment,
    goal: 'RESTORE_PREVIOUS_STATE',
    action: 'ROLLBACK_TRAFFIC_WEIGHTS',
    sourceNodeId: lastActionSnapshot.sourceNodeId,
    targetNodeId: lastActionSnapshot.targetNodeId,
    confidence: 1.0,
    mlClassification: 'ROLLBACK_TRIGGERED',
    result: 'ROLLBACK_EXECUTED',
    evidence: {
      originalAction: actionId,
      reason,
      operator,
      rollbackCount: rollbackHistory.length
    }
  });
  
  // Log event
  eventStore.addEvent('ALERT', null,
    `⏪ ROLLBACK executed: ${reason} (Action: ${actionId})`,
    'HIGH',
    { rollback }
  );
  
  // Broadcast to all clients
  broadcastToAll({
    type: 'action_rolled_back',
    data: rollback
  });
  
  broadcastState();
  
  res.json({
    success: true,
    message: 'Action rolled back successfully',
    rollback
  });
});

