// ── Razorpay Event Integration ────────────────────────────────────────────────
// Receives payment events from BharatBazaar and wires them into the NFV5 pipeline
// This makes payment failures a first-class event type for sentinel/investigator
app.post('/api/razorpay/event', (req, res) => {
  try {
    const {
      eventType,
      severity,
      paymentId,
      orderId,
      amount,
      currency = 'INR',
      errorCode,
      errorDescription,
      method,
      timestamp
    } = req.body;

    console.log(`[Razorpay Event] Received: ${eventType} | Payment: ${paymentId} | Amount: ₹${amount}`);

    // Map Razorpay events to NFV5 event store
    let nfv5EventType = 'INFO';
    let message = '';
    let nfv5Severity = 'LOW';

    switch (eventType) {
      case 'payment.failed':
        nfv5EventType = 'ALERT';
        nfv5Severity = 'CRITICAL';
        message = `💳 Payment failure detected | Amount: ₹${amount} | Error: ${errorDescription || 'Unknown'} | Method: ${method || 'N/A'}`;
        
        // Increment failure counter and accumulate actual revenue loss
        failedRequestsCount++;
        actualRevenueLoss += amount; // amount is already in INR
        
        // Log to event store
        eventStore.addEvent(nfv5EventType, null, message, nfv5Severity, {
          source: 'razorpay',
          paymentId,
          orderId,
          amount,
          currency,
          errorCode,
          errorDescription,
          method,
          timestamp: timestamp || Date.now()
        });
        
        // Broadcast to all connected clients
        broadcastToAll({
          type: 'razorpay_event',
          data: {
            eventType,
            severity: nfv5Severity,
            message,
            amount,
            currency,
            timestamp: Date.now()
          }
        });
        
        console.log(`[Revenue Impact] Total revenue loss: ₹${actualRevenueLoss.toFixed(2)} | Failed payments: ${failedRequestsCount}`);
        break;

      case 'payment.success':
      case 'payment.captured':
      case 'payment.authorized':
        nfv5EventType = 'INFO';
        nfv5Severity = 'LOW';
        message = `✓ Payment ${eventType.split('.')[1]} | Amount: ₹${amount} | Method: ${method || 'N/A'}`;
        
        eventStore.addEvent(nfv5EventType, null, message, nfv5Severity, {
          source: 'razorpay',
          paymentId,
          orderId,
          amount,
          currency,
          method,
          timestamp: timestamp || Date.now()
        });
        break;

      case 'order.paid':
        nfv5EventType = 'INFO';
        nfv5Severity = 'LOW';
        message = `✓ Order paid | Amount: ₹${amount}`;
        
        eventStore.addEvent(nfv5EventType, null, message, nfv5Severity, {
          source: 'razorpay',
          orderId,
          amount,
          currency,
          timestamp: timestamp || Date.now()
        });
        break;

      default:
        console.log(`[Razorpay Event] Unhandled event type: ${eventType}`);
    }

    res.json({ success: true, message: 'Event received and processed' });
  } catch (error) {
    console.error('[Razorpay Event] Processing error:', error);
    res.status(500).json({ success: false, error: error.message });
  }
});

