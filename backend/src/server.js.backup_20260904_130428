// ── BharatBazaar Real-Time Metrics (Response Time Measurement) ────────────────
app.get('/api/bharatbazaar/metrics', async (req, res) => {
  if (activeEnvironment !== 'EXTERNAL') {
    return res.json({ success: false, error: 'Only available in EXTERNAL mode' });
  }

  const metrics = await Promise.all(externalNodes.map(async (node) => {
    const startTime = Date.now();
    const port = parseInt(node.port, 10);
    
    try {
      await new Promise((resolve, reject) => {
        const req = http.get(`http://localhost:${port}/`, { timeout: 5000 }, (response) => {
          response.resume(); // Drain response
          resolve();
        });
        req.on('error', reject);
        req.on('timeout', () => {
          req.destroy();
          reject(new Error('timeout'));
        });
      });
      
      const responseTime = Date.now() - startTime;
      return {
        nodeId: node.nodeId,
        name: node.name,
        port: port,
        responseTime,
        status: responseTime < 200 ? 'healthy' : responseTime < 500 ? 'degraded' : 'slow',
        isHealthy: node.metrics.health > 0,
        timestamp: Date.now()
      };
    } catch (error) {
      return {
        nodeId: node.nodeId,
        name: node.name,
        port: port,
        responseTime: -1,
        status: 'error',
        error: error.message,
        isHealthy: false,
        timestamp: Date.now()
      };
    }
  }));

  res.json({ success: true, metrics, environment: 'EXTERNAL' });
});

